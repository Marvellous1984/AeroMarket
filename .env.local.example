# Supabase (standalone project for this app — not shared with any other project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=enquiries@example.com
ENQUIRY_FROM_EMAIL=no-reply@example.com

# Cloudflare Turnstile (optional — enquiry/seller forms work without it,
# skipping bot verification, until these are set)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
